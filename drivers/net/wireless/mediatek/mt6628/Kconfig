config WLAN_VENDOR_MEDIATEK_MT6628
	tristate "MediaTek MT6628 support"
	depends on MMC || (SERIAL_DEV_BUS && SERIAL_DEV_CTRL_TTYPORT)
	help
	  Enable support for the MediaTek MT6628 combo chip.

	  WLAN bring-up and the shared WMT/BGF/STP transport are provided
	  as separate function drivers.

if WLAN_VENDOR_MEDIATEK_MT6628

config MTK_MT6628_WLAN
	tristate "MediaTek MT6628 WLAN support"
	depends on MMC
	depends on CFG80211
	select FW_LOADER

config MTK_MT6628_STP_SDIO
	tristate "SDIO function-2 transport for MT6628 BGF/STP"
	depends on MMC
	depends on OF
	select MTK_MT6628_STP
	help
	  Build the shared WMT/STP transport over SDIO function 2.

config MTK_MT6628_STP_UART
	tristate "UART transport for MT6628 BGF/STP"
	depends on SERIAL_DEV_BUS && SERIAL_DEV_CTRL_TTYPORT
	select MTK_MT6628_STP
	help
	  Build the shared WMT/STP transport over serdev UART.

config MTK_MT6628_FM
	tristate "MediaTek MT6628 FM radio support"
	depends on VIDEO_DEV
	depends on MTK_MT6628_STP
	select VIDEO_V4L2
	help
	  This enables the FM radio receiver of the MediaTek MT6628 combo
	  chip through the shared function-2 WMT/STP transport.

endif

config MTK_MT6628_STP
	tristate
	select MFD_CORE
	select FW_LOADER
