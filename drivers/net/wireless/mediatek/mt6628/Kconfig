config WLAN_VENDOR_MEDIATEK_MT6628
	tristate "MediaTek MT6628 support"
	depends on MMC
	help
	  Enable support for the MediaTek MT6628 combo chip.

	  The current implementation provides the WLAN SDIO function
	  bring-up and firmware download path.  Shared WMT/BGF/STP support
	  for the other combo-chip functions is not implemented yet.

if WLAN_VENDOR_MEDIATEK_MT6628

config MTK_MT6628_WLAN
	tristate "MediaTek MT6628 WLAN support"
	depends on MMC
	help
	  This enables the WLAN function of the MediaTek MT6628 combo chip.
	  The driver performs the firmware bring-up.  The cfg80211/netdev
	  data path is not wired up yet.


config MTK_MT6628_FM
	tristate "MediaTek MT6628 FM radio support"
	depends on VIDEO_DEV
	select VIDEO_V4L2
	help
	  This enables the FM radio receiver of the MediaTek MT6628 combo
	  chip.  The FM implementation currently depends on the shared
	  BGF/STP transport, which is not implemented in this tree yet.

endif
