config DRM_MEDIATEK
	tristate "DRM Support for Mediatek SoCs"
	depends on DRM
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on COMMON_CLK
	depends on HAVE_ARM_SMCCC || COMPILE_TEST
	depends on OF
	depends on MTK_MMSYS
	select DRM_CLIENT_SELECTION
	select DRM_GEM_DMA_HELPER
	select DRM_KMS_HELPER
	select DRM_DISPLAY_HELPER
	select DRM_BRIDGE_CONNECTOR
	select DRM_MIPI_DSI
	select DRM_PANEL
	select VIDEOMODE_HELPERS
	help
	  Choose this option if you have a Mediatek SoCs.
	  The module will be called mediatek-drm
	  This driver provides kernel mode setting and
	  buffer management to userspace.

config DRM_MEDIATEK_WDMA
	tristate "MediaTek DISP_WDMA write DMA engine"
	depends on DRM_MEDIATEK
	depends on HAS_IOMEM
	depends on RESET_CONTROLLER
	help
	  DISP_WDMA is the display subsystem's write-DMA engine: it takes a
	  pixel stream from an upstream block and writes it out to memory.
	  It is the counterpart of RDMA, which reads from memory instead, and
	  the two are separate blocks.

	  WDMA is not a CRTC path component and never carries a display
	  plane.  It appears in no mtk_ddp_ext array on any SoC this tree
	  supports, so selecting this option on its own will not put anything
	  on a display pipeline; it registers the component and gives the
	  DDP_COMPONENT_WDMA0/1 entries in mtk_ddp_comp.c something to call
	  into.

	  Say Y here if you want the driver built in, M to build it as a
	  module named mtk_disp_wdma, or N to leave WDMA unregistered, which
	  is the same state the MT6589 display driver is in by default.

config DRM_MEDIATEK_DP
	tristate "DRM DPTX Support for MediaTek SoCs"
	depends on DRM_MEDIATEK
	select DRM_DISPLAY_HELPER
	select DRM_DISPLAY_DP_HELPER
	select DRM_DISPLAY_DP_AUX_BUS
	help
	  DRM/KMS Display Port driver for MediaTek SoCs.

config DRM_MEDIATEK_HDMI_COMMON
	tristate
	depends on DRM_MEDIATEK
	select DRM_DISPLAY_HDMI_HELPER
	select DRM_DISPLAY_HELPER
	select SND_SOC_HDMI_CODEC if SND_SOC
	help
	  MediaTek SoC HDMI common library

config DRM_MEDIATEK_HDMI
	tristate "DRM HDMI Support for Mediatek SoCs"
	depends on DRM_MEDIATEK
	select DRM_MEDIATEK_HDMI_COMMON
	help
	  DRM/KMS HDMI driver for Mediatek SoCs

config DRM_MEDIATEK_HDMI_V2
	tristate "DRM HDMI v2 IP support for MediaTek SoCs"
	depends on DRM_MEDIATEK
	select DRM_MEDIATEK_HDMI_COMMON
	help
	  Say yes here to enable support for the HDMIv2 IP and related
	  DDCv2 as found in the MediaTek MT8195, MT8188 SoCs and other
	  variants.
	  This driver can also be built as a module. If so, the HDMIv2
	  module will be called "mtk_hdmi_v2", and the DDCv2 module
	  will be called "mtk_hdmi_ddc_v2".

config DRM_MEDIATEK_G2D
	tristate "MediaTek G2D 2D blitter"
	depends on DRM_MEDIATEK
	depends on HAS_IOMEM
	select DRM_GEM_DMA_HELPER
	help
	  The G2D block in the display subsystem does 2D copies: bitblt
	  between surfaces, and constant-colour fill.  The hardware also
	  offers flips, alpha blending and dithering, which this driver does
	  not yet use.

	  Both G2D objects - the engine and its ioctls - are built from this
	  option.  They used to be split between CONFIG_MTK_G2D and
	  CONFIG_DRM_MEDIATEK, so the ioctl object was built whenever the
	  display driver was, even with the engine itself switched off.

	  The ioctls are not registered on any DRM device yet: the block owns
	  no &drm_device of its own, so this option currently provides the
	  engine and its kernel API only.
