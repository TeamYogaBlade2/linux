/dts-v1/;
#include "mt6589.dtsi"
#include "mt6320.dtsi"

/ {
	chosen {
		/* DEBUG: testing clock drivers */
		bootargs = "clk_ignore_unused";
	};

	memory {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;

		ranges;

		framebuffer_reserved: memory@bf600000{
			reg = <0xbf600000 0xa00000>;
			no-map;
		};
	};
};

&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;
	/* TODO */
//	clock-frequency = <100000>;

	accelerometer@11 {
		compatible = "bosch,bma255";
		reg = <0x11>;
	};

	magnetometer@13 {
		compatible = "bosch,bmm150";
		reg = <0x13>;
	};
};

&uart0 {
	status = "okay";
};

/* Internal storage */
&mmc0 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	vmmc-supply = <&mt6320_ldo_vemc_3v3>;
	vqmmc-supply = <&mt6320_ldo_vemc_1v8>;

	non-removable;
	no-sd;
	no-sdio;
	bus-width = <8>;

	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	mmc-ddr-1_8v;

	assigned-clocks = <&topckgen CLK_TOP_MUX_MSDC0>;
	assigned-clock-parents = <&apmixedsys CLK_APMIXED_MSDCPLL_208M>;
};

/* SD Card */
&mmc1 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
	vmmc-supply = <&mt6320_ldo_vmch1>;
	vqmmc-supply = <&mt6320_ldo_vmc1>;

	bus-width = <4>;
	no-mmc;
	no-sdio;
	/* TODO: recheck */
	cd-gpios = <&pio 171 GPIO_ACTIVE_HIGH>;

	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	sd-uhs-sdr50;
	sd-uhs-ddr50;

	assigned-clocks = <&topckgen CLK_TOP_MUX_MSDC1>;
	assigned-clock-parents = <&apmixedsys CLK_APMIXED_MSDCPLL_208M>;
};

/* SDIO */
&mmc3 {
	status = "disabled";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc3_pins_default>;
	pinctrl-1 = <&mmc3_pins_uhs>;
	/* FIXME: always 1.8V? */
	vmmc-supply = <&mt6320_ldo_vemc_3v3>;
	vqmmc-supply = <&mt6320_ldo_vemc_1v8>;

	bus-width = <4>;
	cap-sdio-irq;
	non-removable;
	no-mmc;
	no-sd;

	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	sd-uhs-sdr50;
	sd-uhs-ddr50;

	assigned-clocks = <&topckgen CLK_TOP_MUX_MSDC3>;
	assigned-clock-parents = <&apmixedsys CLK_APMIXED_MSDCPLL_208M>;
};
