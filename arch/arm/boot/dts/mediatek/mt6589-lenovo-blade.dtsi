/dts-v1/;
#include <dt-bindings/input/input.h>
#include "mt6589.dtsi"

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "lenovo,blade", "mediatek,mt6589";

	chosen {
		linux,initrd-start = <0x82600000>;
		/* DEBUG: testing clock drivers */
		bootargs = "clk_ignore_unused";
	};

	memory {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;

		ranges;

		mtkfb_region: memory@bf600000{
			reg = <0xbf600000 (1280 * 800 * 2 * 2)>;
			no-map;
		};
	};

	framebuffer0: framebuffer@bf600000 {
		compatible = "simple-framebuffer";
		reg = <0xbf600000 (1280 * 800 * 2)>;
		width = <1280>;
		height = <800>;
		stride = <(1280 * 2)>;
		format = "r5g6b5";
	};
};

&pwrap {
	pmic: mt6320 {
		compatible = "mediatek,mt6320";

		pio6320: pinctrl {
			compatible = "mediatek,mt6320-pinctrl";
			gpio-controller;
			#gpio-cells = <2>;
		};
	};

	rtc {
		compatible = "mediatek,mt6320-rtc";
	};

	mt6320keys: keys {
		compatible = "mediatek,mt6320-keys";
		power {
			linux,keycodes = <KEY_POWER>;
			wakeup-source;
		};
		home {
			linux,keycodes = <KEY_HOME>;
		};
	};
};

&uart0 {
	status = "okay";
};
