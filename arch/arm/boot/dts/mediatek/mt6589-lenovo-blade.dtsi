/dts-v1/;
#include <dt-bindings/input/input.h>

#include "mt6589.dtsi"
#include "mt6320.dtsi"

#include <dt-bindings/pinctrl/mt6589-pinfunc.h>
#include <dt-bindings/clock/mediatek,mt6320-clk.h>

/ {
	chosen {
		/* DEBUG: testing clock drivers */
		bootargs = "clk_ignore_unused regulator_ignore_unused";
	};

	memory {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;

		ranges;

		framebuffer_reserved: memory@bf600000{
			reg = <0xbf600000 0xa00000>;
			no-map;
		};
	};
};

&cpu0 {
	proc-supply = <&mt6320_buck_vproc>;
	sram-supply = <&mt6320_buck_vsram>;
};

&cpu1 {
	proc-supply = <&mt6320_buck_vproc>;
	sram-supply = <&mt6320_buck_vsram>;
};

&cpu2 {
	proc-supply = <&mt6320_buck_vproc>;
	sram-supply = <&mt6320_buck_vsram>;
};

&cpu3 {
	proc-supply = <&mt6320_buck_vproc>;
	sram-supply = <&mt6320_buck_vsram>;
};

&pio {
	usb_pins: usb-pins {
		pins_iddig {
			pinmux = <MT6589_GPIO57__FUNC_GPIO57>;
			bias-pull-up;
			input-enable;
		};

		pins_eint34_conflict {
			pinmux = <MT6589_GPIO48__FUNC_GPIO48>;
			bias-pull-up;
			input-enable;
			input-schmitt-enable;
		};

		pins_drvvbus {
			pinmux = <MT6589_GPIO130__FUNC_USB_DRVVBUS>;
		};
	};

	ts_pins: touchscreen-default {
		pin-int {
			pinmux = <MT6589_GPIO124__FUNC_EINT5>;
			input-enable;
			bias-pull-up;
		};

		pin-reset {
			pinmux = <MT6589_GPIO140__FUNC_GPIO140>;
			output-high;
		};
	};
};

&mt6320_ldo_vgp4 {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
};

&mt6320_ldo_vgp6 {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&usb0 {
	status = "okay";
	usb-role-switch;
	vusb-supply = <&mt6320_ldo_vusb>;
	pinctrl-names = "default";
	pinctrl-0 = <&usb_pins>;

	connector {
		compatible = "gpio-usb-b-connector", "usb-b-connector";
		type = "micro";
		id-gpios = <&pio 57 GPIO_ACTIVE_LOW>;
		vbus-supply = <&usb_otg_vbus>;
	};
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	// clock-frequency = <400000>;

	/* Synaptics ClearPad 7300 */
	touchscreen@38 {
		compatible = "syna,rmi4-i2c";
		reg = <0x38>;
		#address-cells = <1>;
		#size-cells = <0>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_pins>;

		interrupts = <5 IRQ_TYPE_EDGE_FALLING>;
		interrupt-parent = <&pio>;

		reset-gpios = <&pio 140 GPIO_ACTIVE_LOW>;

		vdd-supply = <&mt6320_ldo_vgp4>;
		vio-supply = <&mt6320_ldo_vgp6>;

		syna,startup-delay-ms = <100>;
		syna,reset-delay-ms = <50>;

		rmi4-f01@1 {
			reg = <0x1>;
		};

		rmi4-f11@11 {
			reg = <0x11>;
			syna,sensor-type = <1>;
		};

		rmi4-f34@34 {
			reg = <0x34>;
		};
	};
};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
};

&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;
	clock-frequency = <100000>;

	accelerometer@11 {
		compatible = "bosch,bma255";
		reg = <0x11>;

		// TODO: check
		vdd-supply = <&mt6320_ldo_vio28>;
		vddio-supply = <&mt6320_buck_vio18>;
		interrupts = <0 IRQ_TYPE_EDGE_RISING>;
		interrupt-parent = <&pio>;
		// mount-matrix = ?;
	};

	magnetometer@13 {
		compatible = "bosch,bmm150";
		reg = <0x13>;

		// TODO: check
		vdd-supply = <&mt6320_ldo_vio28>;
		vddio-supply = <&mt6320_buck_vio18>;
		interrupts = <2 IRQ_TYPE_EDGE_RISING>; // ?
		// and EINT6, EINT7? + EINT8?
		interrupt-parent = <&pio>;
		// mount-matrix = ?
	};
};

&i2c4 {
	status = "okay";
	clocks = <&pericfg CLK_PERI0_I2C4>,
		 <&mt6320clock MT6320_WRPCKPDN_I2C0>,
		 <&pericfg CLK_PERI0_APDMA>;
	pinctrl-names = "default";
	pinctrl-0 = <&mt6320_i2c0_pins>;
	clock-frequency = <100000>;

	bq27541: fuel-gauge@55 {
		compatible = "ti,bq27541";
		reg = <0x55>;

		interrupts = <16 IRQ_TYPE_EDGE_RISING>; // ?
		interrupt-parent = <&pio>;

		// monitored-battery = ;
	};
};

&i2c5 {
	status = "okay";
	clocks = <&pericfg CLK_PERI0_I2C5>,
		 <&mt6320clock MT6320_WRPCKPDN_I2C1>,
		 <&pericfg CLK_PERI0_APDMA>;
	pinctrl-names = "default";
	pinctrl-0 = <&mt6320_i2c1_pins>;
};

&i2c6 {
	status = "okay";
	clocks = <&pericfg CLK_PERI1_I2C6>,
		 <&mt6320clock MT6320_WRPCKPDN_I2C2>,
		 <&pericfg CLK_PERI0_APDMA>;
	pinctrl-names = "default";
	pinctrl-0 = <&mt6320_i2c2_pins>;
	clock-frequency = <100000>;

	charger@6b {
		compatible = "ti,bq24196";
		reg = <0x6b>;

		poll-interval = <10000>;

		// interrupts = <?? IRQ_TYPE_EDGE_RISING>; // KP row2 R1?
		interrupt-parent = <&pio>;

		// ce-gpios = ??; // KP col7 P5?
		// monitored-battery = ;

		usb_otg_vbus: usb-otg-vbus { };
	};
};

&uart0 {
	status = "okay";
};

/* Internal storage */
&mmc0 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	vmmc-supply = <&mt6320_ldo_vemc_3v3>;
	vqmmc-supply = <&mt6320_ldo_vemc_1v8>;

	non-removable;
	no-sd;
	no-sdio;
	bus-width = <8>;

	max-frequency = <50000000>;

	// max-frequency = <200000000>;
	// cap-mmc-highspeed;
	// mmc-hs200-1_8v;
	// mmc-ddr-1_8v;

	#address-cells = <1>;
	#size-cells = <0>;

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <2>;
			#size-cells = <2>;

			partition@1e0000 {
				label = "MBR";
				reg = <0x00000000 0x001e0000 0x00000000 0x00080000>;
			};

			partition@260000 {
				label = "EBR1";
				reg = <0x00000000 0x00260000 0x00000000 0x00080000>;
			};

			partition@2e0000 {
				label = "__NODL_PMT";
				reg = <0x00000000 0x002e0000 0x00000000 0x00400000>;
			};

			partition@6e0000 {
				label = "__NODL_PRO_INFO";
				reg = <0x00000000 0x006e0000 0x00000000 0x00300000>;
			};

			partition@9e0000 {
				label = "__NODL_NVRAM";
				reg = <0x00000000 0x009e0000 0x00000000 0x00500000>;
			};

			partition@ee0000 {
				label = "__NODL_PROTECT_F";
				reg = <0x00000000 0x00ee0000 0x00000000 0x00a00000>;
			};

			partition@18e0000 {
				label = "__NODL_PROTECT_S";
				reg = <0x00000000 0x018e0000 0x00000000 0x00a00000>;
			};

			partition@22e0000 {
				label = "__NODL_SECCFG";
				reg = <0x00000000 0x022e0000 0x00000000 0x00020000>;
			};

			partition@2300000 {
				label = "UBOOT";
				reg = <0x00000000 0x02300000 0x00000000 0x00060000>;
			};

			partition@2360000 {
				label = "BOOTIMG";
				reg = <0x00000000 0x02360000 0x00000000 0x00600000>;
			};

			partition@2960000 {
				label = "RECOVERY";
				reg = <0x00000000 0x02960000 0x00000000 0x00600000>;
			};

			partition@2f60000 {
				label = "SEC_RO";
				reg = <0x00000000 0x02f60000 0x00000000 0x00600000>;
			};

			partition@3560000 {
				label = "__NODL_MISC";
				reg = <0x00000000 0x03560000 0x00000000 0x00080000>;
			};

			partition@35e0000 {
				label = "LOGO";
				reg = <0x00000000 0x035e0000 0x00000000 0x00300000>;
			};

			partition@38e0000 {
				label = "EBR2";
				reg = <0x00000000 0x038e0000 0x00000000 0x00080000>;
			};

			partition@3960000 {
				label = "__NODL_EXPDB";
				reg = <0x00000000 0x03960000 0x00000000 0x00a00000>;
			};

			partition@4360000 {
				label = "FAC";
				reg = <0x00000000 0x04360000 0x00000000 0x0c800000>;
			};

			partition@10b60000 {
				label = "ANDROID";
				reg = <0x00000000 0x10b60000 0x00000000 0x40000000>;
			};

			partition@50b60000 {
				label = "CACHE";
				reg = <0x00000000 0x50b60000 0x00000000 0x07e00000>;
			};

			partition@58960000 {
				label = "USRDATA";
				reg = <0x00000000 0x58960000 0x00000003 0x49fa0000>;
			};

			partition@3a2900000 {
				label = "__NODL_BMTPOOL";
				reg = <0x00000003 0xa2900000 0x00000000 0x01500000>;
			};
		};
	};
};

/* SD Card */
&mmc1 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
	vmmc-supply = <&mt6320_ldo_vmch1>;
	vqmmc-supply = <&mt6320_ldo_vmc1>;

	bus-width = <4>;
	no-mmc;
	no-sdio;
	/* TODO: recheck */
	cd-gpios = <&pio 171 GPIO_ACTIVE_HIGH>;

	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	sd-uhs-sdr50;
	sd-uhs-ddr50;
};

/* SDIO */
&mmc3 {
	status = "disabled";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc3_pins_default>;
	pinctrl-1 = <&mmc3_pins_uhs>;
	/* FIXME: always 1.8V? */
	vmmc-supply = <&mt6320_ldo_vemc_3v3>;
	vqmmc-supply = <&mt6320_ldo_vemc_1v8>;

	bus-width = <4>;
	cap-sdio-irq;
	non-removable;
	no-mmc;
	no-sd;

	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	sd-uhs-sdr50;
	sd-uhs-ddr50;
};

&keyboard {
	status = "okay";
	linux,keymap = <MATRIX_KEY(0, 0, KEY_VOLUMEUP)
			MATRIX_KEY(0, 2, KEY_VOLUMEDOWN)>;
	keypad,num-rows = <1>;
	keypad,num-columns = <3>;
	debounce-delay-ms = <32>;
};

&pwm {
	status = "okay";
};
