/dts-v1/;
#include "mt6582.dtsi"
#include "mt6323.dtsi"
#include <dt-bindings/pinctrl/mt6582-pinfunc.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/power/mediatek,mt6582-power.h>
#include <dt-bindings/iio/adc/mediatek,mt6323-auxadc.h>



/ {
	model = "Lenovo IdeaTab A7600-h";
	compatible = "lenovo,a7600h", "mediatek,mt6582";

	aliases {
		serial0 = &uart0;
		mmc0 = &mmc0;
		mmc1 = &mmc1;

	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		
		bootargs = "console=ttyS0,921600n8 console=tty0 clk_ignore_unused pd_ignore_unused regulator_ignore_unused loglevel=8  earlycon root=/dev/mmcblk1p1 rootwait rw "; 
		stdout-path = "serial0:921600n8";

		// framebuffer: framebuffer@be900000 {
		// 	compatible = "simple-framebuffer";
		// 	memory-region = <&framebuffer_reserved>;
		// 	width = <1280>;
		// 	height = <800>;
		// 	stride = <(1280 * 2)>;
		// 	format = "r5g6b5";
		// 	// status = "okay";
		// 	status = "disabled";
		// 	power-domains = <&spm MT6582_POWER_DOMAIN_DIS>;
		// };
	};

	cpus {
		cpu@0 {
			proc-supply = <&mt6323_vproc_reg>;
		};

		cpu@1 {
			proc-supply = <&mt6323_vproc_reg>;
		};

		cpu@2 {
			proc-supply = <&mt6323_vproc_reg>;
		};

		cpu@3 {
			proc-supply = <&mt6323_vproc_reg>;
		};
	};
	
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	// reserved-memory {
	// 	#address-cells = <1>;
	// 	#size-cells = <1>;
	// 	ranges;

	// 	framebuffer_reserved: framebuffer@be900000 {
	// 		reg = <0xbe900000 0x00800000>;
	// 		no-map;
	// 	};
	// };

	gpu_opp_table: opp-table-gpu {

		opp-598000000 {
			opp-hz = /bits/ 64 <598000000>;
			opp-microvolt = <1250000>;
		};
	};

	panel_backlight: backlight {
        	compatible = "pwm-backlight";
        	pwms = <&bls 0 20000>; 
        	gpios = <&pio 18 GPIO_ACTIVE_HIGH>;
        	post-pwm-on-delay-ms = <10>;
        	pwm-off-delay-ms = <10>;
        	brightness-levels = <
              		4   8  12  16  20  24  28
             		32  40  48  56  64  72  80  88
             		96 112 128 144 160 176 192 208
            		224 240 255 >;
        	default-brightness-level = <16>; 
		pinctrl-names = "default";
    		pinctrl-0 = <&backlight_pins>;
   	};

	vcc_3v3_tps: regulator-tps62237 {
    		compatible = "regulator-fixed";
    		regulator-name = "vcc-3v3";
    		regulator-min-microvolt = <3300000>;
    		regulator-max-microvolt = <3300000>;
			
    		// gpios = <&pio 118 GPIO_ACTIVE_LOW>; 
		// startup_delay = <10000>;

	};

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp = <6340000>;
		voltage-min-microvolt = <3200000>;
		voltage-max-microvolt = <4200000>;
		constant-charge-current-microamp = <2000000>;
		constant-charge-voltage-microvolt = <4200000>;
		precharge-current-microamp = <200000>;
		charge-term-current-microamp = <100000>;
	};

};

&pwrap {
	pmic: mt6323 {
		compatible = "mediatek,mt6323";
		interrupt-parent = <&pio>;
		interrupts = <25 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <2>;
		pinctrl-names = "default";
        	pinctrl-0 = <&pmic_int_pins>;

		mt6323_leds: leds {
			status = "disabled";
		};	
		
		mt6323regulator: mt6323regulator {
			mt6323_vusb_reg: ldo_vusb {
				regulator-always-on;
			};
		}; 
	};

};

&pio {
	status = "okay";
};

&keyboard {
	status = "okay";
	linux,keymap = <MATRIX_KEY(0, 0, KEY_VOLUMEUP)
			MATRIX_KEY(0, 1, KEY_VOLUMEDOWN)>;
	keypad,num-rows = <1>;
	keypad,num-columns = <2>;
	debounce-delay-ms = <32>;
};

&usb {
	status = "okay";
	
	dr_mode = "otg";
	usb-role-switch-default-mode = "peripheral";
	usb-role-switch;
	connector {
			compatible = "gpio-usb-b-connector", "usb-b-connector";
			type = "micro";
			pinctrl-0 = <&usb0_id_pin>;
			pinctrl-names = "default";
			id-gpios = <&pio 17 GPIO_ACTIVE_HIGH>;
			vbus-supply = <&usb_otg_vbus>;

	};
};

&u2phy0 {
	status = "okay";
	phy-supply = <&mt6323_vusb_reg>;
};

&u2port0 {
	status = "okay";
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&msdc0_pins_default>;
	pinctrl-1 = <&msdc0_pins_uhs>;
	status = "okay";
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	vmmc-supply = <&mt6323_vemc3v3_reg>;
	vqmmc-supply = <&mt6323_vio18_reg>;
	non-removable;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	no-sd;
	no-sdio;
	mediatek,latch-ck = <0>;
};

&mmc1 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&msdc1_pins_default>;
	pinctrl-1 = <&msdc1_pins_uhs>;
	status = "okay";
	bus-width = <4>;
	// max-frequency = <100000000>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	cd-gpios = <&pio 14 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6323_vmch_reg>;
	vqmmc-supply = <&mt6323_vmc_reg>;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	// sd-uhs-sdr50;
	// sd-uhs-sdr104;
	// sd-uhs-ddr50;
	cap-sd-highspeed;
	no-mmc;
	no-sdio;
	no-write-protect;
	mediatek,latch-ck = <0>;

};

&uart0 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	clock-frequency = <400000>;

	touchscreen@5d {
		compatible = "goodix,gt9110";
		reg = <0x5d>;
		interrupt-parent = <&pio>;
		interrupts = <10 IRQ_TYPE_EDGE_FALLING>;
		irq-flags = <2>;
		irq-gpios = <&pio 10 GPIO_ACTIVE_HIGH>;
        	reset-gpios = <&pio 13 GPIO_ACTIVE_HIGH>;
		AVDD28-supply = <&mt6323_vgp2_reg>;
		VDDIO-supply = <&mt6323_vio18_reg>;
		pinctrl-names = "default";
    		pinctrl-0 = <&touch_pins_default>; 
		touchscreen-size-x = <1280>;
    		touchscreen-size-y = <800>;

      	};

};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	clock-frequency = <400000>;

	bq27541_fg: fuel-gauge@55 {
		compatible = "ti,bq27541";
		reg = <0x55>;
		interrupt-parent = <&pio>;
		interrupts = <5 IRQ_TYPE_EDGE_FALLING>;
		monitored-battery = <&battery>;
      	};

	charger: bq24196@6b {
		compatible = "ti,bq24196";
		reg = <0x6b>;
		pinctrl-names = "default";
		pinctrl-0 = <&bq24196_pins>;

		interrupt-parent = <&pio>;
		interrupts = <9 IRQ_TYPE_EDGE_FALLING>;

		ce-gpios = <&pio 19 GPIO_ACTIVE_LOW>;
		omit-battery-class;
		ti,system-minimum-microvolt = <3200000>;
		monitored-battery = <&battery>;
		usb_otg_vbus: usb-otg-vbus {};
	};
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	clock-frequency = <400000>;
	
	accelerometer@e {
		compatible = "kionix,kxtj21009";
		reg = <0x0e>;
		vddio-supply = <&mt6323_vio18_reg>;
            	vdd-supply = <&mt6323_vio28_reg>;
		interrupt-parent = <&pio>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>;

		mount-matrix = "0", "1", "0",
			"1", "0", "0",
			"0", "0", "-1";
	};
};

&pio {
	status = "okay";
	pwrap_pins_default: pwrap-default {
		pins_ {
			pinmux = <MT6582_PIN_21_PWRAP_SPI0_MI__FUNC_PWRAP_SPIDO>,
			<MT6582_PIN_22_PWRAP_SPI0_MO__FUNC_PWRAP_SPIDI>,
			<MT6582_PIN_23_PWRAP_SPI0_CK__FUNC_PWRAP_SPICK_I>,
			<MT6582_PIN_24_PWRAP_SPI0_CSN__FUNC_PWRAP_SPICS_B_I>;
			input-enable;
			bias-disable;
		};
        
    	};

	pmic_int_pins: pmic-int {
		pins {
			pinmux = <MT6582_PIN_25_PWRAP_INT__FUNC_GPIO25>;
			input-enable;
			bias-pull-down; 
			debounce-interval = <1000>; 
		};
    	};

	msdc1_pins_default: msdc1-default {
		pins-cmd-dat{
		 	pinmux = <MT6582_PIN_124_MSDC1_CMD__FUNC_MSDC1_CMD>,
		 	 	 <MT6582_PIN_126_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
			 	 <MT6582_PIN_127_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
		 	 	 <MT6582_PIN_128_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
		 	 	 <MT6582_PIN_129_MSDC1_DAT3__FUNC_MSDC1_DAT3>;
		 	input-enable;
		 	bias-pull-up;

		};
		pins-clk {
		 	pinmux = <MT6582_PIN_125_MSDC1_CLK__FUNC_MSDC1_CLK>;
			bias-pull-down;
		 	drive-strength = <4>;
		};
		sd-detect {
			pinmux = <MT6582_PIN_14_EINT14__FUNC_GPIO14>;
			input-enable;
			bias-pull-up;
		};
	};

	msdc1_pins_uhs: msdc1 {
		pins-cmd-dat{
		 	pinmux = <MT6582_PIN_124_MSDC1_CMD__FUNC_MSDC1_CMD>,
		 	 	 <MT6582_PIN_126_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
		 	 	 <MT6582_PIN_127_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
		 	 	 <MT6582_PIN_128_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
		 		 <MT6582_PIN_129_MSDC1_DAT3__FUNC_MSDC1_DAT3>;
		 	input-enable;
		 	bias-pull-up;
		 	drive-strength = <8>;
		};
		pins-clk {
		 	pinmux = <MT6582_PIN_125_MSDC1_CLK__FUNC_MSDC1_CLK>;
		 	bias-pull-down;
		 	drive-strength = <12>;
		};
		sd-detect {
			pinmux = <MT6582_PIN_14_EINT14__FUNC_GPIO14>;
			input-enable;
			bias-pull-up;
		};
	};

	touch_pins_default: touch-pins {
		pins-irq {
			pinmux = <MT6582_PIN_10_EINT10__FUNC_GPIO10>;
			input-enable;
			bias-pull-up;
        	};
		pins-reset {
			pinmux = <MT6582_PIN_13_GPIO13__FUNC_GPIO13>;
			output-high;
		};
    	};

	bq24196_pins: bq24196-pins {
		pins_int {
			pinmux = <MT6582_PIN_9_EINT9__FUNC_GPIO9>;
			input-enable;
			bias-pull-up;
			debounce-interval = <1000>;
		};
		pins_ce {
			pinmux = <MT6582_PIN_19_EINT19__FUNC_GPIO19>;
			output-low;
		};
	};

	usb0_id_pin: usb0 {
		pins-usb-id{
			pinmux = <MT6582_PIN_17_EINT17__FUNC_IDDIG>;
			bias-pull-up;
			input-enable;
			debounce-interval = <1000>;
		};
	};

	backlight_pins: backlight-pins {
		pins_bl_pwm {
			pinmux = <MT6582_PIN_90_DISP_PWM__FUNC_DISP_PWM>;
			drive-strength = <MTK_DRIVE_8mA>;
		};
	
    	};
};

&mali {
	status = "okay";
};

&mmsys {
	// status = "disabled";
	port {
		#address-cells = <1>;
		#size-cells = <0>;
			mmsys_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&ovl_in>;
				// remote-endpoint = <&rdma0_in>;
			};
	};
};

&ovl0 {
	// status = "disabled";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			ovl_in: endpoint@0 {
				remote-endpoint = <&mmsys_out>;
			};
		};

		port@1 {
			reg = <1>;
			ovl_out: endpoint@1 {
				remote-endpoint = <&rdma0_in>;
			};
		};
	};
};

&rdma0 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			rdma0_in: endpoint@0 {
				remote-endpoint = <&ovl_out>;
				// remote-endpoint = <&mmsys_out>;
			};
		};

		port@1 {
			reg = <1>;
			rdma0_out: endpoint@1 {
				remote-endpoint = <&color_in>;
			};
		};
	};
};

&color {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			color_in: endpoint@0 {
				remote-endpoint = <&rdma0_out>;
			};
		};

		port@1 {
			reg = <1>;
			color_out: endpoint@1 {
				remote-endpoint = <&bls_in>;
			};
		};
	};
};

&bls {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			bls_in: endpoint@0 {
				remote-endpoint = <&color_out>;
			};
		};

		port@1 {
			reg = <1>;
			bls_out: endpoint@1 {
				remote-endpoint = <&dsi_in>;
			};
		};
	};
};

&dsi {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			dsi_in: endpoint@0 {
				remote-endpoint = <&bls_out>;
			};
		};

		port@1 {
			reg = <1>;
			dsi_out: endpoint@1 {
				remote-endpoint = <&panel_in>;
			};
		};
	};

	panel@0 {
		compatible = "boe,bp101wx1-210";
		reg = <0>;
		
		power-supply = <&vcc_3v3_tps>; 
		panel-orientation = "normal"; 
		backlight = <&panel_backlight>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0{
				reg = <0>;
				panel_in: endpoint {
					remote-endpoint = <&dsi_out>;
				};
			};
		};
	};
};

// &dsi_out {
// 	remote-endpoint = <&panel_in>;
// };

&bls {
	status = "okay";
};

&gce {
	status = "okay";
};
