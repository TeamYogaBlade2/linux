#include "mt6589-lenovo-blade.dtsi"

/ {
	// TODO: recheck it
	framebuffer0: framebuffer@bf600000 {
		compatible = "simple-framebuffer";
		memory-region = <&framebuffer_reserved>;
		width = <800>;
		height = <1280>;
		stride = <(800 * 2)>;
		format = "r5g6b5";
	};
};
