#include "mt6589-lenovo-blade.dtsi"

/ {
	// TODO: recheck it
	framebuffer0: framebuffer@bf600000 {
		compatible = "simple-framebuffer";
		memory-region = <&framebuffer_reserved>;
		width = <800>;
		height = <1280>;
		stride = <(800 * 2)>;
		format = "r5g6b5";
	};

	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion-polymer";

		charge-full-design-microamp-hours = <6000000>;
		energy-full-design-microwatt-hours = <22500000>;

		/*
		 * Stock fuel-gauge voltage/SOC table uses 3400mV as 0%.
		 * This is a vendor software threshold, not a proven
		 * physical cell absolute minimum voltage.
		 */
		voltage-min-design-microvolt = <3400000>;

		/*
		 * Full-charge/design maximum voltage.  The stock BQ24196
		 * configuration programs VREG to 4.352V.
		 */
		voltage-max-design-microvolt = <4352000>;

		/* BQ24196 stock configuration. */
		precharge-current-microamp = <256000>;
		charge-term-current-microamp = <256000>;

		constant-charge-voltage-max-microvolt = <4352000>;
	};
};

&bq27541 {
	monitored-battery = <&battery>;
};

&bq24196 {
	monitored-battery = <&battery>;
};

/*
 * Panel pins.  The equivalent group for the B8000 lives in
 * mt6589-lenovo-b8000.dtsi, which this board does not include, so it is
 * declared here rather than referenced across files.
 */
&pio {
	b6000_panel_pins: b6000-panel-pins {
		pins_power_en {
			pinmux = <MT6589_GPIO137__FUNC_GPIO137>;
		};
	};
};

/*
 * The B6000 uses a different panel from the B8000 tablet and it is not a
 * "simple panel" - both candidate parts need a manufacturer init sequence,
 * so they are handled by panel-lenovo-b6000.c rather than panel-simple.
 *
 * The vendor kernel picks between two parts at runtime by reading board-ID
 * GPIO 0x9a (154) in lcm_compare_id_2().  This tree names the part in DT
 * instead; a board that can carry either should override
 * "lenovo,b6000-nt35521-cmi" with "lenovo,b6000-s6d7aa0x04-cpt".
 */
&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "lenovo,b6000-nt35521-cmi";
		reg = <0>;

		vdd-supply = <&mt6320_ldo_vrf28_2>;
		vddi-supply = <&mt6320_ldo_vrf28_2>;
		backlight = <&backlight_lcd>;
		enable-gpios = <&pio 137 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&b6000_panel_pins>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

/* The panel's DSI output endpoint is declared by the SoC dtsi. */
&dsi_out {
	remote-endpoint = <&panel_in>;
};
