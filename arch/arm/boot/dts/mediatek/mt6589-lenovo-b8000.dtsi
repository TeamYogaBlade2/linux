#include "mt6589-lenovo-blade.dtsi"


&pio {
	panel_pins: panel-pins {
		pins_power_en {
			pinmux = <MT6589_GPIO137__FUNC_GPIO137>;
		};
	};
};

&mt6320_ldo_vrf28_2 {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "boe,hx8896-a01-panel";
		reg = <0>;
		power-supply = <&mt6320_ldo_vrf28_2>;
		enable-gpios = <&pio 137 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_pins>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	/*
	panel@0 {
		compatible = "innolux,hx8896-a01-panel";
		reg = <0>;
		power-supply = <&mt6320_ldo_vrf28_2>;
		enable-gpios = <&pio 137 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_pins>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
	*/

	port {
		dsi_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};

	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion-polymer";

		charge-full-design-microamp-hours = <9000000>;
		energy-full-design-microwatt-hours = <33750000>;

		/*
		 * Stock fuel-gauge voltage/SOC table uses 3400mV as 0%.
		 * This is a vendor software threshold, not a proven
		 * physical cell absolute minimum voltage.
		 */
		voltage-min-design-microvolt = <3400000>;

		/*
		 * Full-charge/design maximum voltage.  The stock BQ24196
		 * configuration programs VREG to 4.352V.
		 */
		voltage-max-design-microvolt = <4352000>;

		/* BQ24196 stock configuration. */
		precharge-current-microamp = <512000>;
		charge-term-current-microamp = <256000>;

		constant-charge-voltage-max-microvolt = <4352000>;
	};
};

&bq27541 {
	monitored-battery = <&battery>;
};

&bq24196 {
	monitored-battery = <&battery>;
};
